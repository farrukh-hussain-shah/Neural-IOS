    "Neural Key is an AI keyboard for iPhone. It works inside the apps you already chat in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Key es un teclado con IA para iPhone. Funciona dentro de las apps en las que ya chateas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Key é um teclado com IA para iPhone. Funciona nos apps em que você já conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Key — клавиатура с ИИ для iPhone. Она работает в приложениях, где вы уже общаетесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Key لوحة مفاتيح بالذكاء الاصطناعي لجهاز iPhone. تعمل داخل التطبيقات التي تدردش فيها بالفعل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Key 是一款适用于 iPhone 的 AI 键盘，可在你常用的聊天应用中使用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Key iPhone के लिए एक AI कीबोर्ड है। यह उन्हीं ऐप्स में काम करता है जिनमें आप पहले से चैट करते हैं।"
          }
        }
      }
    },
