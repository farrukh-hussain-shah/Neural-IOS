    "Back in Settings, switch on Allow Full Access, then tap Allow to confirm.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vuelta en Ajustes, activa Permitir acceso completo y toca Permitir para confirmar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De volta aos Ajustes, ative Permitir Acesso Total e toque em Permitir para confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь в Настройки, включите «Разрешить полный доступ» и нажмите «Разрешить»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الإعدادات، فعّل السماح بالوصول الكامل، ثم اضغط سماح للتأكيد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到“设置”，开启“允许完全访问”，然后轻点“允许”确认。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में वापस जाकर फ़ुल एक्सेस की अनुमति चालू करें, फिर पुष्टि के लिए अनुमति दें पर टैप करें।"
          }
        }
      }
    },
